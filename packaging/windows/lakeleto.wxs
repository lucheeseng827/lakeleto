<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer: double-click, next, done.

  Built by build-msi.ps1 in this directory, which also builds the binaries and
  regenerates the icon. Requires WiX 5 (see that script for why not 6 or 7).

  Two deliberate choices:

  * **perUser scope.** A perMachine install writes to Program Files and therefore
    triggers a UAC elevation prompt — on an installer that is very likely
    unsigned on somebody's first try, that is the second scary dialog in a row.
    Lakeleto is a personal read-only data viewer, not a service; installing it to
    the user's own LocalAppData needs no admin rights at all.
  * **Both binaries ship.** `lakeleto-desktop.exe` is what the Start Menu entry
    runs, but `lakeleto.exe` is the documented CLI and the thing scripts call, so
    the install folder also goes on the user's PATH.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Lakeleto"
      Manufacturer="Lakeleto"
      Version="$(var.Version)"
      Scope="perUser"
      Compressed="yes"
      Language="1033"
      Codepage="1252"
      UpgradeCode="7AB29C97-D376-4B98-B7E0-54FEDAAB1D51">
      <!-- UpgradeCode identifies "this product" across every version ever shipped.
           Changing it makes Windows treat a new release as a *different* product
           and install it alongside the old one. It must never change. -->

    <SummaryInformation Description="Lakeleto — the Postman of lakehouse tables" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Lakeleto is already installed. Uninstall it first." />

    <!-- One embedded cab: the .msi is the whole download, nothing beside it. -->
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="LakeletoIcon" SourceFile="lakeleto.ico" />
    <Property Id="ARPPRODUCTICON" Value="LakeletoIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lucheeseng827/lakeleto" />
    <!-- No repair option in Add/Remove Programs: there is nothing to repair in a
         two-file copy, and the button only ever confuses people. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Lakeleto" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Lakeleto" />
    </StandardDirectory>

    <Feature Id="Main" Title="Lakeleto" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="DesktopExe">
        <File Id="LakeletoDesktopExe" Source="$(var.BinDir)\lakeleto-desktop.exe" KeyPath="yes" />
      </Component>

      <Component Id="CliExe">
        <File Id="LakeletoExe" Source="$(var.BinDir)\lakeleto.exe" KeyPath="yes" />
        <!-- Put the CLI on PATH for the terminal half of the audience. `System="no"`
             keeps this in the user's own environment, which is what a perUser
             install is allowed to touch. -->
        <Environment
            Id="PathEntry"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="no" />
        <!-- Uninstall removes the two files but not the directory holding them,
             so without this %LocalAppData%\Lakeleto survives as an empty folder.
             Safe to remove: the app keeps its workspaces under $LAKELETO_HOME,
             never here. -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- The shortcut lives in its own component under the Start Menu folder. Its
         KeyPath is a registry value rather than a file, because a perUser install
         has no per-machine file to anchor to and MSI requires every component in
         HKCU-land to be keyed that way. -->
    <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="9E1B4C2A-6F3D-4A7E-9C08-2D5B1F8A6E43">
      <Shortcut
          Id="LakeletoStartMenuShortcut"
          Name="Lakeleto"
          Description="Open Lakeleto — inspect Parquet, CSV and Iceberg tables locally"
          Target="[INSTALLFOLDER]lakeleto-desktop.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="LakeletoIcon" />
      <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Lakeleto"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
